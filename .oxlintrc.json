{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-var": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ]
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".pnpm-store/**", ".idea/**", "public/**"]
}
