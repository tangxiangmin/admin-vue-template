{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "ignore",
  "ignorePatterns": ["dist/**", "node_modules/**", ".pnpm-store/**", ".idea/**", "public/**", "pnpm-lock.yaml"]
}
